# 复制为 .env 后填写（请勿提交 .env）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 多维表格：https://xxx.feishu.cn/base/{APP_TOKEN}?table={TABLE_ID}
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=
# 接收合同文件的成员 open_id，多个英文逗号分隔（与 PRD 一致）
FEISHU_RECEIVER_OPEN_IDS=
# 可选：合同上传到云空间的文件夹 token（不填则跳过云盘上传，仅发 IM）
FEISHU_DRIVE_FOLDER_TOKEN=
# 交付格式：pdf（默认）/ docx
DELIVERY_FORMAT=pdf
# PDF 引擎：auto | word | libreoffice（阿里云 FC / Linux 请用 libreoffice）
PDF_ENGINE=libreoffice
